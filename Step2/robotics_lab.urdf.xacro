<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotics_lab">

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="table_macro.xacro" />
    <xacro:include filename="rrbot_macro.xacro" />

    <link name="world" />

    <!--  TABLE 1: 1 ROBOT  -->
    <xacro:table prefix="table1_" parent="world">
        <origin xyz="-9 0 1" rpy="0 0 0" />
    </xacro:table>

    <xacro:rrbot prefix="rrbot1_" parent="table1_top">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:rrbot>


    <!--  TABLE 2: 2 ROBOTS  -->
    <xacro:table prefix="table2_" parent="world">
        <origin xyz="-3 0 1" rpy="0 0 0" />
    </xacro:table>

    <xacro:rrbot prefix="rrbot2_" parent="table2_top">
        <origin xyz="-1 0 0" rpy="0 0 0" />
    </xacro:rrbot>

    <xacro:rrbot prefix="rrbot3_" parent="table2_top">
        <origin xyz="1 0 0" rpy="0 0 0" />
    </xacro:rrbot>


    <!--  TABLE 3: 3 ROBOTS  -->
    <xacro:table prefix="table3_" parent="world">
        <origin xyz="3 0 1" rpy="0 0 0" />
    </xacro:table>

    <xacro:rrbot prefix="rrbot4_" parent="table3_top">
        <origin xyz="-1 0 0" rpy="0 0 0" />
    </xacro:rrbot>

    <xacro:rrbot prefix="rrbot5_" parent="table3_top">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:rrbot>

    <xacro:rrbot prefix="rrbot6_" parent="table3_top">
        <origin xyz="1 0 0" rpy="0 0 0" />
    </xacro:rrbot>


    <!--  TABLE 4: 4 ROBOTS  -->
    <xacro:table prefix="table4_" parent="world">
        <origin xyz="0 6 1" rpy="0 0 0" />
    </xacro:table>

    <xacro:rrbot prefix="rrbot7_" parent="table4_top">
        <origin xyz="-1 0.5 0" rpy="0 0 0" />
    </xacro:rrbot>

    <xacro:rrbot prefix="rrbot8_" parent="table4_top">
        <origin xyz="1 0.5 0" rpy="0 0 0" />
    </xacro:rrbot>

    <xacro:rrbot prefix="rrbot9_" parent="table4_top">
        <origin xyz="-1 -0.5 0" rpy="0 0 0" />
    </xacro:rrbot>

    <xacro:rrbot prefix="rrbot10_" parent="table4_top">
        <origin xyz="1 -0.5 0" rpy="0 0 0" />
    </xacro:rrbot>

</robot>